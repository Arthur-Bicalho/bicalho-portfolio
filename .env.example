# Copie este arquivo para .env.local:  cp .env.example .env.local
# Todas as variáveis são opcionais: sem elas o site abre normalmente.

# Opcionais: só para testar o comando "guestbook"
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcionais: só para testar o comando "contato"
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID_FOR_ME=
VITE_EMAILJS_TEMPLATE_ID_FOR_SENDER=
VITE_EMAILJS_PUBLIC_KEY=

# Opcional: Google reCAPTCHA v2 ("Não sou um robô") no formulário do "contato".
# Crie em https://www.google.com/recaptcha/admin (tipo "Desafio (v2)" →
# "Caixa de seleção Não sou um robô") com os domínios do seu site (ex.: arthur-bicalho.vercel.app) e localhost.
# Aqui vai só a SITE KEY, que é pública. A SECRET KEY NÃO vai aqui: ela fica no
# painel do EmailJS, no template FOR SENDER (Settings → reCAPTCHA V2).
# Sem a site key, o formulário abre sem o reCAPTCHA.
VITE_RECAPTCHA_SITE_KEY=

# Opcional: token da GitHub API para os comandos "github" e "stats".
# No "stats", o token soma as linguagens por bytes de código (GraphQL) e fica de
# reserva quando o limite por IP do visitante (60 chamadas/hora) acaba.
# Use um token fine-grained, só com leitura de repositórios públicos.
# Sem VITE_ na frente, de propósito: ele fica só no servidor, no proxy
# /api/github (Vercel Function api/github.js; no npm run dev, o vite.config.js),
# e nunca vai para o build. Na Vercel, crie a mesma variável no projeto.
GITHUB_SITE_TOKEN=

# Opcional: só para o comando "ask" (perguntas sobre mim, respondidas por IA).
# Chave grátis do Google AI Studio: https://aistudio.google.com/apikey
# (Get API key → Create API key). Sem VITE_ na frente, de propósito: ela fica
# só no servidor, na rota /api/ask (Vercel Function api/ask.js; no npm run
# dev, o vite.config.js), e nunca vai para o build. Na Vercel, crie a mesma
# variável no projeto. Sem ela, o "ask" avisa que não está configurado.
GEMINI_API_KEY=

# Opcionais: trocar o modelo (padrão gemini-3.5-flash-lite) ou usar outra API
# compatível com a da OpenAI (Groq, OpenRouter, OpenAI...). Com outro
# provedor, a chave dele vai no GEMINI_API_KEY (ou em ASK_API_KEY).
# ASK_MODEL=gemini-3.5-flash-lite
# ASK_API_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Opcional: só para ver a linha do clima da boas-vindas no npm run dev.
# Em produção a Vercel descobre a cidade do visitante pelo IP (cabeçalhos
# x-vercel-ip-*) e o clima vem do Open-Meteo, sem chave nenhuma. No dev esses
# cabeçalhos não existem: aqui vai "latitude,longitude,cidade,UF,país".
# CLIMA_LOCAL_DEV=-19.92,-43.94,Belo Horizonte,MG,BR
